# ArogyaMitra Mobile Application Environment Configuration
# Local Backend URL (10.0.2.2 maps to host localhost:5000 inside Android Emulator)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api
API_BASE_URL=http://10.0.2.2:5000/api

# Production Cloud Backend (Uncomment when building for production/remote testing)
# EXPO_PUBLIC_API_BASE_URL=https://arogyamitra-backend.example.com/api
# API_BASE_URL=https://arogyamitra-backend.example.com/api
