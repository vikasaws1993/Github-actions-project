{
  "extends": "./node_modules/@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@auth/*": ["./src/auth/*"],
      "@citizen/*": ["./src/citizen/*"],
      "@sevak/*": ["./src/arogya-sevak/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/**/*",
    "index.js",
    "App.tsx"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/__tests__/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
